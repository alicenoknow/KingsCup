{
  "expo": {
    "name": "King's Cup",
    "slug": "kings-cup",
    "version": "2.0.0",
    "orientation": "portrait",
    "owner": "alicenoknow",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alicenoknow.kingscup"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.alicenoknow.kingscup",
      "versionCode": 4
    },
    "extra": {
      "eas": {
        "projectId": "18487e4d-5d58-406f-89ed-29dd6fb7cd64"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#fcf8e6",
          "imageWidth": 100
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.0.21",
            "gradleVersion": "8.13"
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
